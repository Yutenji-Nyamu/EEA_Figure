        <mxCell id="XWM3R7zpG73houLtDdQO-23" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="&lt;p data-pm-slice=&quot;1 1 []&quot;&gt;Agentic layer over existing simulation benchmarks,&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;enabling promptable and interpretable evaluation.&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="50" width="560" x="-590" y="246.25" as="geometry" />
        </mxCell>
        <mxCell id="XWM3R7zpG73houLtDdQO-25" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="&lt;div style=&quot;line-height: 20%;&quot;&gt;&lt;p data-pm-slice=&quot;1 1 []&quot;&gt;Current simulation benchmarks usually require exhaustive rollouts, offer little customization, and provide only&amp;nbsp;&lt;/p&gt;&lt;p data-pm-slice=&quot;1 1 []&quot;&gt;success rates,&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;whereas human experts can form efficient and fine grained judgments from a few trials.&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="600" x="-581.47" y="299.25" as="geometry" />
        </mxCell>
        <mxCell id="XWM3R7zpG73houLtDdQO-26" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="ManipEvalAgent is a three-stage framework that plans evaluation aspects, generates tasks and evaluation tools&amp;nbsp;&lt;div style=&quot;text-align: left;&quot;&gt;in simulation,&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;and executes multi-round assessment with adaptive refinement.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="620" x="-589.47" y="590" as="geometry" />
        </mxCell>
        <mxCell id="XWM3R7zpG73houLtDdQO-28" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="&lt;div style=&quot;line-height: 20%;&quot;&gt;&lt;p data-pm-slice=&quot;1 1 []&quot;&gt;ManipEvalAgent substantially reduces evaluation&lt;/p&gt;&lt;p data-pm-slice=&quot;1 1 []&quot;&gt;time&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;while maintaining generally comparable&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p data-pm-slice=&quot;1 1 []&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;conclusions to existing simulation benchmarks&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="280" x="60.37999999999998" y="460" as="geometry" />
        </mxCell>
        <mxCell id="XWM3R7zpG73houLtDdQO-29" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;Task Generatioin &amp;amp; Tool Generation&lt;/font&gt;" vertex="1">
